# Copy to .env at the repo root (docker-compose) and to backend/.env.
# Do not import this file into Vercel. Vercel only hosts frontend/ (see LAUNCH.md).
# POSTGRES_*, JWT_*, STRIPE_* belong on Render, not Vercel.

POSTGRES_USER=safebid
POSTGRES_PASSWORD=safebid
POSTGRES_DB=safebid
POSTGRES_PORT=5432
DATABASE_URL=postgresql://safebid:safebid@localhost:5432/safebid?schema=public

# Backend
NODE_ENV=development
PORT=4000
FRONTEND_URL=http://localhost:3000
JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d
PLATFORM_COMMISSION_BPS=500
MOCK_PAYMENTS=true
MOCK_IDENTITY=true

# OAuth (optional)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=

# Stripe (optional when MOCK_*=true)
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_IDENTITY_RETURN_URL=http://localhost:3000/verify/return

# Uploads
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=8

# Set to require an invite code on registration (friends beta)
INVITE_CODE=

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
NEXT_PUBLIC_MOCK_PAYMENTS=true

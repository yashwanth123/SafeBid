# Vercel: set Root Directory to `frontend` (not repo root, not Services).
# Leave NEXT_PUBLIC_API_URL empty so the browser calls same-origin /api.
NEXT_PUBLIC_API_URL=
NEXT_PUBLIC_MOCK_PAYMENTS=true
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# Server-only. Local default, or your Render URL in production:
# API_INTERNAL_URL=http://127.0.0.1:4000
API_INTERNAL_URL=http://127.0.0.1:4000

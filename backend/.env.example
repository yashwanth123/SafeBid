NODE_ENV=development
PORT=4000
FRONTEND_URL=http://localhost:3000
DATABASE_URL=postgresql://safebid:safebid@localhost:5432/safebid?schema=public
JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars
